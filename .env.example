# ============================================================
# PPTNC Poke Deck - Variaveis de ambiente (exemplo)
# Copie este arquivo para ".env" e preencha com valores reais.
# Nunca comite o arquivo .env.
# ============================================================

# ---------- Backend (Spring Boot) ----------
# Chave secreta para assinatura JWT (minimo 32 caracteres).
JWT_SECRET=troque-esta-chave-por-uma-chave-bem-longa-e-aleatoria

# Tempo de expiracao do JWT em milissegundos (padrao 24h).
JWT_EXPIRATION=86400000

# Origens permitidas para CORS (separadas por virgula).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# String JDBC de conexao com o SQLite (caminho dentro do container).
SPRING_DATASOURCE_URL=jdbc:sqlite:/data/pokedeck.db

# Credenciais do usuario master criadas no seeding (Sprint 4).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---------- Frontend (Next.js) ----------
# URL publica do backend usada pelo frontend.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
